<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="edge-to-edge"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.calorietracker.ui.controller.SettingsController">
    <VBox spacing="20" styleClass="page">
        <padding>
            <Insets top="28" right="32" bottom="32" left="32"/>
        </padding>

        <Label text="Einstellungen" styleClass="page-title"/>

        <VBox styleClass="card" spacing="16" prefWidth="480" minWidth="360" maxWidth="560">
            <Label text="Erscheinungsbild" styleClass="card-title"/>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Dark Mode" styleClass="field-label"/>
                    <Label text="Dunkles Farbschema für die gesamte App" styleClass="entry-detail"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane fx:id="darkModeSwitchContainer"/>
            </HBox>
        </VBox>

        <VBox styleClass="card" spacing="16" prefWidth="480" minWidth="360" maxWidth="560">
            <Label text="Daten" styleClass="card-title"/>
            <Label text="Setzt dein Profil und alle Tagebucheinträge unwiderruflich zurück." styleClass="entry-detail" wrapText="true"/>
            <Button text="Alle Daten zurücksetzen" styleClass="danger-button" onAction="#resetData"/>
        </VBox>

        <VBox styleClass="card" spacing="10" prefWidth="480" minWidth="360" maxWidth="560">
            <Label text="Über" styleClass="card-title"/>
            <Label text="Kalorien Tracker v1.0 — ein nativer Java/JavaFX Kalorien- und Nährstofftracker im Apple-Stil. Alle Daten werden ausschließlich lokal auf deinem Rechner gespeichert."
                   styleClass="entry-detail" wrapText="true"/>
        </VBox>
    </VBox>
</ScrollPane>
