<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.calorietracker.ui.controller.MainViewController"
            styleClass="app-root">
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="4">
            <padding>
                <Insets top="28" right="14" bottom="20" left="20"/>
            </padding>
            <Label text="🍎 Kalorien Tracker" styleClass="sidebar-title" wrapText="true"/>
            <Region prefHeight="24"/>

            <Button fx:id="navToday" text="Heute" styleClass="nav-button" onAction="#showToday" maxWidth="Infinity"/>
            <Button fx:id="navCalendar" text="Kalender" styleClass="nav-button" onAction="#showCalendar" maxWidth="Infinity"/>
            <Button fx:id="navProfile" text="Profil" styleClass="nav-button" onAction="#showProfile" maxWidth="Infinity"/>
            <Button fx:id="navSettings" text="Einstellungen" styleClass="nav-button" onAction="#showSettings" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Label text="v1.0" styleClass="sidebar-footer"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area"/>
    </center>
</BorderPane>
